<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f5f7f4">
    <title>Short URLs | Your links, in one place</title>
    <style>
        :root {
            color-scheme: light;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #17231d;
            background: #f5f7f4;
            font-synthesis: none;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 320px;
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(ellipse at 12% 0%, rgba(196, 228, 185, 0.3), transparent 34%),
                #f5f7f4;
        }

        a {
            color: inherit;
        }

        .shell {
            width: min(100% - 48px, 1120px);
            margin: 0 auto;
        }

        .topbar {
            display: flex;
            min-height: 82px;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(31, 48, 37, 0.08);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #17231d;
            font-size: 15px;
            font-weight: 750;
            letter-spacing: -0.035em;
            text-decoration: none;
        }

        .brand-mark {
            display: grid;
            width: 32px;
            height: 32px;
            place-items: center;
            border-radius: 10px;
            background: #c5f36c;
        }

        .brand-mark svg {
            width: 18px;
            height: 18px;
        }

        .account-link {
            display: inline-flex;
            min-height: 38px;
            align-items: center;
            padding: 0 15px;
            border: 1px solid #dfe5df;
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.75);
            color: #344239;
            font-size: 12px;
            font-weight: 650;
            text-decoration: none;
            transition: border-color 150ms ease, background 150ms ease;
        }

        .account-link:hover {
            border-color: #b7c9ad;
            background: #fff;
        }

        .main {
            padding: 64px 0 80px;
        }

        .hero {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 32px;
            margin-bottom: 34px;
        }

        .eyebrow {
            margin: 0 0 12px;
            color: #68894b;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        h1 {
            max-width: 650px;
            margin: 0;
            color: #17231d;
            font-size: clamp(36px, 5vw, 56px);
            font-weight: 680;
            letter-spacing: -0.06em;
            line-height: 1.04;
        }

        .hero-copy {
            max-width: 470px;
            margin: 15px 0 0;
            color: #748078;
            font-size: 15px;
            line-height: 1.7;
        }

        .hero-note {
            flex: 0 0 auto;
            margin: 0 0 6px;
            color: #7f8981;
            font-size: 12px;
        }

        .shorten-card {
            position: relative;
            overflow: hidden;
            margin-bottom: 44px;
            padding: 30px;
            border-radius: 18px;
            background: #18251e;
            box-shadow: 0 18px 48px rgba(28, 43, 33, 0.12);
            color: #f4f7f1;
        }

        .shorten-card::after {
            position: absolute;
            top: -150px;
            right: -60px;
            width: 340px;
            height: 340px;
            border: 1px solid rgba(197, 243, 108, 0.13);
            border-radius: 50%;
            content: "";
            pointer-events: none;
        }

        .card-heading {
            position: relative;
            z-index: 1;
            margin-bottom: 19px;
        }

        .card-heading h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 650;
            letter-spacing: -0.025em;
        }

        .card-heading p {
            margin: 6px 0 0;
            color: #aab8ad;
            font-size: 12px;
            line-height: 1.6;
        }

        .shorten-form {
            position: relative;
            z-index: 1;
            display: flex;
            gap: 11px;
        }

        .url-input {
            width: 100%;
            min-width: 0;
            height: 52px;
            padding: 0 16px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 10px;
            outline: none;
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font: inherit;
            font-size: 13px;
            transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
        }

        .url-input::placeholder {
            color: #9daaa0;
        }

        .url-input:focus {
            border-color: #c5f36c;
            background: rgba(255, 255, 255, 0.11);
            box-shadow: 0 0 0 3px rgba(197, 243, 108, 0.17);
        }

        .submit {
            display: inline-flex;
            min-width: 142px;
            height: 52px;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0 18px;
            border: 0;
            border-radius: 10px;
            background: #c5f36c;
            color: #1c2a20;
            cursor: pointer;
            font: inherit;
            font-size: 13px;
            font-weight: 750;
            transition: transform 150ms ease, background 150ms ease;
        }

        .submit:hover {
            transform: translateY(-1px);
            background: #b8e85e;
        }

        .submit svg {
            width: 16px;
            height: 16px;
        }

        .section-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 16px;
        }

        .section-heading h2 {
            margin: 0;
            color: #17231d;
            font-size: 21px;
            font-weight: 680;
            letter-spacing: -0.04em;
        }

        .section-heading p {
            margin: 5px 0 0;
            color: #818b83;
            font-size: 12px;
        }

        .url-count {
            flex: 0 0 auto;
            padding: 7px 10px;
            border: 1px solid #e3e9e1;
            border-radius: 999px;
            background: #fff;
            color: #647064;
            font-size: 11px;
            font-weight: 650;
        }

        .table-card {
            overflow: hidden;
            border: 1px solid #e6ebe5;
            border-radius: 14px;
            background: #fff;
            box-shadow: 0 8px 28px rgba(28, 43, 33, 0.04);
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            padding: 14px 20px;
            border-bottom: 1px solid #edf0ec;
            background: #fafbf9;
            color: #89928b;
            font-size: 10px;
            font-weight: 750;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        td {
            max-width: 0;
            padding: 17px 20px;
            border-bottom: 1px solid #f0f2ef;
            color: #4a574e;
            font-size: 12px;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:hover {
            background: #fcfdfb;
        }

        .short-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #527a32;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .short-link:hover {
            color: #385923;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .link-icon {
            width: 14px;
            height: 14px;
            flex: 0 0 auto;
        }

        .destination {
            overflow: hidden;
            color: #818b83;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .clicks {
            color: #344239;
            font-variant-numeric: tabular-nums;
            font-weight: 650;
            white-space: nowrap;
        }

        .empty-state {
            padding: 48px 24px;
            text-align: center;
        }

        .empty-icon {
            display: grid;
            width: 44px;
            height: 44px;
            place-items: center;
            margin: 0 auto 13px;
            border-radius: 13px;
            background: #f0f6e8;
            color: #628443;
        }

        .empty-icon svg {
            width: 21px;
            height: 21px;
        }

        .empty-state h3 {
            margin: 0;
            color: #28352c;
            font-size: 14px;
            font-weight: 700;
        }

        .empty-state p {
            margin: 7px 0 0;
            color: #818b83;
            font-size: 12px;
        }

        .brand:focus-visible,
        .account-link:focus-visible,
        .submit:focus-visible,
        .short-link:focus-visible {
            outline: 3px solid #83b83b;
            outline-offset: 3px;
        }

        @media (max-width: 700px) {
            .shell {
                width: min(100% - 32px, 560px);
            }

            .main {
                padding: 45px 0 56px;
            }

            .hero {
                display: block;
                margin-bottom: 27px;
            }

            h1 {
                font-size: clamp(36px, 10vw, 48px);
            }

            .hero-copy {
                font-size: 14px;
            }

            .hero-note {
                margin-top: 16px;
            }

            .shorten-card {
                margin-bottom: 36px;
                padding: 24px 20px;
            }

            .shorten-form {
                flex-direction: column;
            }

            .submit {
                width: 100%;
            }

            th,
            td {
                padding-right: 14px;
                padding-left: 14px;
            }

            th:first-child,
            td:first-child {
                padding-left: 16px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <header class="topbar shell">
        <a class="brand" href="/" aria-label="Short URLs home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M10 13.5 14 9.5m-6.5 6.5-1 1a3.18 3.18 0 0 1-4.5-4.5l4-4a3.18 3.18 0 0 1 4.5 0m3.5 2 1-1a3.18 3.18 0 0 1 4.5 4.5l-4 4a3.18 3.18 0 0 1-4.5 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            Short URLs
        </a>
        <a class="account-link" href="#links">View my links</a>
    </header>

    <main class="main shell">
        <section class="hero" aria-labelledby="page-title">
            <div>
                <p class="eyebrow">Your link workspace</p>
                <h1 id="page-title">Shorten your links.<br>Share with confidence.</h1>
                <p class="hero-copy">Turn long URLs into clean, easy-to-share links. Keep everything organized in one place.</p>
            </div>
            <p class="hero-note">A little less link. A lot more room.</p>
        </section>

        <section class="shorten-card" aria-labelledby="shorten-heading">
            <div class="card-heading">
                <h2 id="shorten-heading">Create a short link</h2>
                <p>Paste a destination URL below to get started.</p>
            </div>
            <form class="shorten-form" action="/url" method="POST">
                <input class="url-input" type="url" name="url" placeholder="https://example.com/your-long-link" aria-label="URL to shorten" autocomplete="url" required>
                <button class="submit" type="submit">
                    Shorten link
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </form>
        </section>

        <section id="links" aria-labelledby="links-heading">
            <div class="section-heading">
                <div>
                    <h2 id="links-heading">Your links</h2>
                    <p>All your shortened URLs, together.</p>
                </div>
                <span class="url-count"><%= urls.length %> <%= urls.length === 1 ? 'link' : 'links' %></span>
            </div>

            <div class="table-card">
                <% if (urls.length) { %>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Short link</th>
                                    <th scope="col">Destination</th>
                                    <th scope="col">Clicks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% urls.forEach(url => { %>
                                    <tr>
                                        <td>
                                            <a class="short-link" href="/<%= url.shortId %>" target="_blank" rel="noopener noreferrer">
                                                <svg class="link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <path d="M10 13.5 14 9.5m-6.5 6.5-1 1a3.18 3.18 0 0 1-4.5-4.5l4-4a3.18 3.18 0 0 1 4.5 0m3.5 2 1-1a3.18 3.18 0 0 1 4.5 4.5l-4 4a3.18 3.18 0 0 1-4.5 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                                <%= url.shortId %>
                                            </a>
                                        </td>
                                        <td class="destination" title="<%= url.redirectUrl %>"><%= url.redirectUrl %></td>
                                        <td class="clicks"><%= url.visitHistory.length %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M10 13.5 14 9.5m-6.5 6.5-1 1a3.18 3.18 0 0 1-4.5-4.5l4-4a3.18 3.18 0 0 1 4.5 0m3.5 2 1-1a3.18 3.18 0 0 1 4.5 4.5l-4 4a3.18 3.18 0 0 1-4.5 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <h3>No links yet</h3>
                        <p>Your new short links will show up here.</p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>
</body>
</html>
